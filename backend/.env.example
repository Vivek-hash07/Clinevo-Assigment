# Copy to backend/.env (gitignored). Never commit real values.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-hex-or-string
TOKEN_ENCRYPTION_KEY=replace-with-another-long-random-hex-or-string

FRONTEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8080
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
APP_ENV=development
AWS_REGION=ap-south-1

# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# Origin: http://localhost:8000
# Redirect URI: http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

INNGEST_DEV=1
# Production Inngest Cloud (leave unset locally):
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# --- Render production (set in the Render dashboard, not this file) ---
# PYTHON_VERSION=3.12.8
# APP_ENV=production
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# INNGEST_DEV=false
# FRONTEND_URL=https://YOUR-APP.vercel.app
# BACKEND_URL=https://clinevo-api.onrender.com
# GOOGLE_REDIRECT_URI=https://clinevo-api.onrender.com/api/auth/google/callback
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_RETRIES=3
PDF_MAX_PAGES=40
PDF_RENDER_SCALE=2.0
OCR_CONFIDENCE_THRESHOLD=0.72
